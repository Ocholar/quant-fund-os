from core.config import settings

STABLE_OR_FIAT_BASES = {
    "USDT", "USDC", "BUSD", "DAI", "TUSD", "FDUSD", "USD1",
    "USD", "EUR", "GBP", "JPY", "TRY", "BRL"
}


def passes_strict_long_filter(features: dict) -> bool:
    """
    Only allow long entries when trend, momentum, and one-tick momentum
    are all positive.
    """
    try:
        return (
            bool(features.get("ready", False))
            and float(features.get("trend", 0.0)) > 0
            and float(features.get("momentum", 0.0)) > 0
            and float(features.get("one_tick_momentum", 0.0)) > 0
        )
    except Exception:
        return False


def _get(obj, name, default=None):
    if isinstance(obj, dict):
        return obj.get(name, default)
    return getattr(obj, name, default)


class SimpleAllocator:
    def __init__(self, strategy_engine=None):
        self.strategy_engine = strategy_engine

    def allocate(self, features, equity, cash=None, strategy_engine=None):
        orders = []

        if cash is None:
            cash = equity

        if strategy_engine is None:
            strategy_engine = self.strategy_engine

        if not features or equity <= 0 or cash <= 0:
            return orders

        if strategy_engine is None:
            return orders

        best = strategy_engine.best_strategy()
        if not best:
            return orders

        strategy = _get(best, "strategy")
        score = float(_get(best, "score", 0.0) or 0.0)

        if strategy is None:
            return orders

        strategy_name = _get(strategy, "name", "unknown_strategy")
        risk_fraction = float(_get(strategy, "risk_fraction", 0.02) or 0.02)
        trend_threshold = float(_get(strategy, "trend_threshold", 0.0) or 0.0)
        momentum_threshold = float(_get(strategy, "momentum_threshold", 0.0) or 0.0)

        remaining_cash = float(cash)

        ranked = sorted(
            features.items(),
            key=lambda item: item[1].get("signal_strength", 0.0),
            reverse=True,
        )

        for symbol, f in ranked:
            active_real_orders = len([o for o in orders if not o.get("shadow_mode")])
            if active_real_orders >= settings.max_new_entries_per_cycle:
                break

            if not passes_strict_long_filter(f):
                continue

            base = symbol.split("/")[0].upper()
            if settings.stablecoin_filter_enabled and base in STABLE_OR_FIAT_BASES:
                continue

            trend_ok = float(f.get("trend", 0.0)) > trend_threshold
            momentum_ok = float(f.get("momentum", 0.0)) > momentum_threshold
            long_trend_ok = float(f.get("long_trend", 0.0)) >= -0.003
            one_tick_ok = float(f.get("one_tick_momentum", 0.0)) > 0

            if not (trend_ok and momentum_ok and long_trend_ok and one_tick_ok):
                continue

            notional = float(equity) * risk_fraction

            initial_equity = float(getattr(settings, "initial_equity", 10.0) or 10.0)
            if float(equity) < initial_equity * 0.98:
                notional *= 0.50

            notional = min(notional, remaining_cash)

            if notional < settings.min_trade_notional:
                continue

            price = float(f["price"])
            qty = notional / price

            orders.append({
                "symbol": symbol,
                "side": "buy",
                "qty": qty,
                "price": price,
                "strategy": strategy_name,
                "confidence": score,
                "shadow_mode": False,
            })

            remaining_cash -= notional
            if remaining_cash < settings.min_trade_notional:
                break

        return orders


RLAllocator = SimpleAllocator
