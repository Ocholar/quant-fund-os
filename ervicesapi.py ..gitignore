[32m+[m[32mdef recent_symbol_buy_count(symbol: str):[m
[32m+[m[32m    """[m
[32m+[m[32m    Count recent buys for a symbol in a rolling window.[m
[32m+[m[32m    This replaces lifetime trade_counts blocking.[m
[32m+[m[32m    """[m
[32m+[m[32m    try:[m
[32m+[m[32m        with engine.begin() as conn:[m
[32m+[m[32m            row = conn.execute(text("""[m
[32m+[m[32m                SELECT COUNT(*) AS count[m
[32m+[m[32m                FROM trades[m
[32m+[m[32m                WHERE symbol = :symbol[m
[32m+[m[32m                  AND side = 'buy'[m
[32m+[m[32m                  AND created_at >= datetime('now', '+3 hours', '-' || :hours || ' hours')[m
[32m+[m[32m            """), {[m
[32m+[m[32m                "symbol": symbol,[m
[32m+[m[32m                "hours": TRADE_COUNT_WINDOW_HOURS,[m
[32m+[m[32m            }).mappings().first()[m
[32m+[m
[32m+[m[32m        return int(row["count"] or 0) if row else 0[m
[32m+[m[32m    except Exception:[m
[32m+[m[32m        return int(trade_counts.get(symbol, 0) or 0)[m
[32m+[m
[32m+[m
[32m+[m[32mdef refresh_recent_trade_counts():[m
[32m+[m[32m    """[m
[32m+[m[32m    Rebuild in-memory trade_counts from only recent buy trades.[m
[32m+[m[32m    Keeps diagnostics and can_buy aligned with the rolling window.[m
[32m+[m[32m    """[m
[32m+[m[32m    global trade_counts[m
[32m+[m[32m    trade_counts = {}[m
[32m+[m
[32m+[m[32m    try:[m
[32m+[m[32m        with engine.begin() as conn:[m
[32m+[m[32m            rows = conn.execute(text("""[m
[32m+[m[32m                SELECT symbol, COUNT(*) AS count[m
[32m+[m[32m                FROM trades[m
[32m+[m[32m                WHERE side = 'buy'[m
[32m+[m[32m                  AND created_at >= datetime('now', '+3 hours', '-' || :hours || ' hours')[m
[32m+[m[32m                GROUP BY symbol[m
[32m+[m[32m            """), {[m
[32m+[m[32m                "hours": TRADE_COUNT_WINDOW_HOURS,[m
[32m+[m[32m            }).mappings().all()[m
[32m+[m
[32m+[m[32m        for r in rows:[m
[32m+[m[32m            trade_counts[r["symbol"]] = int(r["count"] or 0)[m
[32m+[m
[32m+[m[32m    except Exception as e:[m
[32m+[m[32m        print("TRADE_COUNT_REFRESH_ERROR:", e)[m
[32m+[m
[32m+[m
