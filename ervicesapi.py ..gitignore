[32m+[m[32mdef update_position_peak_change(symbol, change):[m
[32m+[m[32m    old_peak = position_peak_change.get(symbol)[m
[32m+[m
[32m+[m[32m    if old_peak is None:[m
[32m+[m[32m        position_peak_change[symbol] = change[m
[32m+[m[32m    else:[m
[32m+[m[32m        position_peak_change[symbol] = max(float(old_peak), float(change))[m
[32m+[m
[32m+[m[32m    return float(position_peak_change.get(symbol, change))[m
