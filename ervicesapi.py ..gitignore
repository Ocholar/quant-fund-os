[32m+[m[32mdef _feature_value(data, key, default=0.0):[m
[32m+[m[32m    try:[m
[32m+[m[32m        if isinstance(data, dict):[m
[32m+[m[32m            return float(data.get(key, default) or 0.0)[m
[32m+[m[32m    except Exception:[m
[32m+[m[32m        pass[m
[32m+[m[32m    return float(default or 0.0)[m
[32m+[m
[32m+[m
[32m+[m[32mdef _entry_signal_threshold(regime):[m
[32m+[m[32m    r = str(regime or "").upper()[m
[32m+[m[32m    if r == "SIDEWAYS":[m
[32m+[m[32m        return ENTRY_MIN_SIGNAL_SIDEWAYS[m
[32m+[m[32m    return ENTRY_MIN_SIGNAL_TRENDING[m
[32m+[m
[32m+[m
[32m+[m[32mdef _is_normal_feature(data):[m
[32m+[m[32m    """[m
[32m+[m[32m    Raw momentum fallback must never be tradable.[m
[32m+[m[32m    Missing source is treated as NORMAL because current FeatureStore[m
[32m+[m[32m    often emits feature dicts without a source field.[m
[32m+[m[32m    """[m
[32m+[m[32m    if not isinstance(data, dict):[m
[32m+[m[32m        return False[m
[32m+[m[32m    source = str(data.get("source", "NORMAL")).upper()[