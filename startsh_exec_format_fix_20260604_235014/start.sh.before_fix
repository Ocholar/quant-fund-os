#!/bin/bash
set -e

mkdir -p /app/data

python -c '
import os, sqlite3, traceback
db = os.environ.get("DB_PATH") or os.environ.get("DATABASE_PATH") or "/app/data/quant.db"
os.environ["DB_PATH"] = db
os.environ["DATABASE_PATH"] = db
os.environ["SQLITE_DB_PATH"] = db
os.environ["QFOS_DB_PATH"] = db
os.environ["QUANT_DB_PATH"] = db
os.environ["DATABASE_URL"] = "sqlite:///" + db if db.startswith("/") else "sqlite:///" + os.path.abspath(db)
parent = os.path.dirname(os.path.abspath(db))
os.makedirs(parent, exist_ok=True)
print("[STARTUP_DB_INIT] db=", db)
print("[STARTUP_DB_INIT] parent=", parent, "exists=", os.path.exists(parent), "writable=", os.access(parent, os.W_OK))
try:
    con = sqlite3.connect(db, timeout=30)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=30000")
    con.execute("CREATE TABLE IF NOT EXISTS db_probe(id INTEGER PRIMARY KEY, ts TEXT DEFAULT CURRENT_TIMESTAMP)")
    con.commit()
    con.close()
    print("[STARTUP_DB_INIT] DB_OK")
except Exception as e:
    print("[STARTUP_DB_INIT] DB_FAIL", repr(e))
    traceback.print_exc()
    raise
'

# Initialize the database
python init_full_sqlite.py

# Start the Uvicorn API server in the background
python -m uvicorn services.api:app --host 0.0.0.0 --port 8080 &

# Start the main quantitative research bot in the foreground
python main.py

