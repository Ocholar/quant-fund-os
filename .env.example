APP_ENV=local
LIVE_TRADING=false
REQUIRE_HUMAN_APPROVAL=true
DATABASE_URL=sqlite:///quant.db
REDIS_URL=redis://localhost:6379/0

# Capital and risk
STARTING_EQUITY=10
MAX_DAILY_LOSS=0.01
MAX_PORTFOLIO_DRAWDOWN=0.05
MAX_LEVERAGE=0.5
MAX_TOTAL_EXPOSURE_PCT=0.95
MAX_SYMBOL_EXPOSURE_PCT=0.20
MAX_TRADES_PER_SYMBOL=999999
STOP_LOSS_PCT=0.012
TAKE_PROFIT_PCT=0.035
TAKE_PROFIT_SELL_FRACTION=0.60
TRADING_FEE_RATE=0.0005
COOLDOWN_SECONDS=10
SIDEWAYS_MAX_ENTRIES_PER_HOUR=999999
SIDEWAYS_MIN_CONFIDENCE=0.62
TRENDING_MAX_ENTRIES_PER_HOUR=999999
TRENDING_MIN_CONFIDENCE=0.58
MAX_NEW_ENTRIES_PER_CYCLE=12
MIN_TRADE_NOTIONAL=0.10
STABLECOIN_FILTER_ENABLED=true

TRADE_INTERVAL_SECONDS=30
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,LINK/USDT,AVAX/USDT,INJ/USDT,SUI/USDT,LTC/USDT,BCH/USDT,ATOM/USDT,NEAR/USDT,TIA/USDT

# Market data
USE_REAL_MARKET_DATA=true
MARKET_DATA_EXCHANGE=binance

# Exchange Settings
EXCHANGE_NAME=paper
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_EXCHANGE_TYPE=spot
MEXC_LEVERAGE=1

# Alert Settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_ENABLED=false
